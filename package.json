{
  "name": "ediurnum",
  "version": "1.1.1",
  "description": "A private, self-hosted, encrypted journal for daily reflection with optional AI feedback",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": "github:ZZELAV/ediurnum",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/**/*.test.ts\"",
    "test:e2e": "node --test --disable-warning=ExperimentalWarning --test-concurrency=1 \"e2e/**/*.test.ts\"",
    "test:all": "npm test && npm run build && npm run test:e2e",
    "convert": "node --disable-warning=ExperimentalWarning scripts/convert.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "devalue": "^5.9.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.3.5"
  }
}
