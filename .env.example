# Optional: ediurnum version from Docker Hub (e.g. 1.2.0). Default: latest
# EDIURNUM_VERSION=latest

# Public address where ediurnum is reachable through your reverse proxy.
# Must match exactly (protection against cross-site requests, secure cookies, push sender).
# Without HTTPS (home network only) use the http:// address, e.g. http://192.168.1.10:3000 –
# push notifications and installing the app then do not work.
ORIGIN=https://journal.example.com

# Take the real client IP from the proxy (used to slow down password guessing) – keep both lines.
# XFF_DEPTH = number of proxies in front of the container (1 for NGINX Proxy Manager alone). See docs/DEPLOYMENT.md
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Time zone for "today" and for reminder times
TZ=Europe/Zurich

# Maximum upload size (restoring a backup)
BODY_SIZE_LIMIT=50M

# Optional: mark the session cookie "Secure" (sent over HTTPS only): true or false.
# Default follows ORIGIN (https:// → true, http:// → false). Only set it if that does not fit.
# COOKIE_SECURE=

# Optional: sender for push services (mailto: or https: address). Defaults to ORIGIN.
# VAPID_SUBJECT=mailto:you@example.com

# Optional: log detail (error, warn, info, debug). "debug" also logs every request. Default: info
# LOG_LEVEL=info

# Optional: token for the dashboard endpoint /api/widget (number of entries, time of the latest save,
# written today, current streak – never content).
# At least 16 characters, e.g. from "openssl rand -hex 32". Without it, the endpoint is off.
# WIDGET_TOKEN=
