# Public address where ediurnum is reachable through your reverse proxy.
# Must match exactly (protection against cross-site requests, secure cookies, push sender).
ORIGIN=https://journal.example.com

# Take the real client IP from the proxy (used to slow down password guessing)
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Time zone for "today" and for reminder times
TZ=Europe/Zurich

# Maximum upload size (restoring a backup)
BODY_SIZE_LIMIT=50M

# Optional: sender for push services (mailto: or https: address). Defaults to ORIGIN.
# VAPID_SUBJECT=mailto:you@example.com
