# Optional: ediurnum version from Docker Hub (e.g. 0.1.0-beta.5). Default: latest
# EDIURNUM_VERSION=latest

# Public address where ediurnum is reachable through your reverse proxy.
# Must match exactly (protection against cross-site requests, secure cookies, push sender).
ORIGIN=https://journal.example.com

# Take the real client IP from the proxy (used to slow down password guessing)
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Time zone for "today" and for reminder times
TZ=Europe/Zurich

# Maximum upload size (restoring a backup)
BODY_SIZE_LIMIT=50M

# Optional: sender for push services (mailto: or https: address). Defaults to ORIGIN.
# VAPID_SUBJECT=mailto:you@example.com

# Optional: log detail (error, warn, info, debug). "debug" also logs every request. Default: info
# LOG_LEVEL=info

# Optional: token for the dashboard endpoint /api/widget (number of entries, date of the latest entry).
# At least 16 characters, e.g. from "openssl rand -hex 32". Without it, the endpoint is off.
# WIDGET_TOKEN=
